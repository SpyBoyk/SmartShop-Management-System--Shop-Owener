# SmartShop Backend Environment Configuration

PROJECT_NAME="SmartShop API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL / AsyncPG)
# For local Docker: postgresql+asyncpg://smartshop:smartshop123@localhost:5432/smartshop_db
# For zero-config local testing: sqlite+aiosqlite:///./smartshop.db
DATABASE_URL="sqlite+aiosqlite:///./smartshop.db"
POSTGRES_USER="smartshop"
POSTGRES_PASSWORD="smartshop123"
POSTGRES_DB="smartshop_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# App Server
HOST="0.0.0.0"
PORT=8000

